# Demo app config for E2E tests — PRODUCTION bridge backend.
# Loaded by `vite --mode test.prod`, i.e. `bun run test:e2e:prod`.
#
# Tracked in git on purpose: it holds no secrets, and a clean checkout has to be
# able to run the prod suite without anyone hand-writing a file first.
#
# No API / hosted URLs: the SDK resolves its own production endpoints, which is
# exactly the real user experience. They are still written out EMPTY, because a
# key this file leaves out falls through to `demo/.env` / `demo/.env.local`
# (a developer's untracked files) — see .env.test.stage (TBP-721).

# Deliberately EMPTY: global-setup seeds a per-worker prod app id into
# localStorage as `bridge:appId`, and a value here would override it.
VITE_BRIDGE_APP_ID=
VITE_BRIDGE_API_BASE_URL=
VITE_BRIDGE_HOSTED_URL=

# Makes src/utils/env.ts skip the hosted-URL override entirely, and is what the
# navbar env pill shows for global-setup to assert against the project.
VITE_ENVIRONMENT=prod

VITE_BRIDGE_CALLBACK_URL=
VITE_BRIDGE_AUTH_BASE_URL=
VITE_BRIDGE_DEFAULT_REDIRECT_ROUTE=
VITE_BRIDGE_LOGIN_ROUTE=
VITE_BRIDGE_TEAM_MANAGEMENT_URL=
VITE_BRIDGE_DEBUG=true
