# bridge-react demo: local configuration
#
# Copy to `.env.local` and set the issuer. Vite loads `.env.local`
# automatically and it is gitignored.
#
#   cp .env.example .env.local

# The issuer: copy it from your app's settings in Bridge. It is the one
# setting the plugin needs; every endpoint is read from it. Add this demo's
# address (http://localhost:3001) to the app's browser addresses, its sign-in
# returns and its email-links addresses.
VITE_BRIDGE_ISSUER=

# `memory` keeps the session in the page's memory only: nothing in the
# browser's storage, and a reload signs in again. Default: localStorage.
# VITE_DEMO_STORAGE=memory
