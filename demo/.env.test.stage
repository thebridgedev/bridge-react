# Demo app config for E2E tests — STAGE bridge backend.
# Loaded by `vite --mode test.stage`, i.e. `bun run test:e2e:stage`.
#
# Tracked in git on purpose: it holds only public stage endpoints, and a clean
# checkout has to be able to run the stage suite without anyone hand-writing a
# file first.
#
# EVERY key the demo reads is written here, even when the value is empty. Vite's
# precedence is `.env.[mode]` > `.env.local` > `.env`, so a key this file LEAVES
# OUT falls through to `demo/.env` / `demo/.env.local` — a developer's untracked
# files, which pin some other app id and backend. Silence here is not "use the
# default"; it is "use whatever the developer happens to have" (TBP-721).

# Deliberately EMPTY. `e2e/playwright/global-setup.ts` provisions one stage app
# per Playwright worker and seeds its id into localStorage as `bridge:appId`,
# which `src/utils/env.ts` passes to <BridgeProvider>. The provider lets this
# variable OVERRIDE that prop, so a value here pins every worker to one app. To
# serve this demo by hand outside Playwright, put a stage app id here.
VITE_BRIDGE_APP_ID=

# The stage API. auth-core derives the auth endpoints (`<api>/auth`) and the
# realtime endpoints from it.
VITE_BRIDGE_API_BASE_URL=https://api-stage.thebridge.dev

# The stage hosted login portal. Without it the SDK defaults to the PRODUCTION
# portal (auth.thebridge.dev), which does not know a stage app id and answers
# hosted login with "[GraphQL] App not found".
VITE_BRIDGE_HOSTED_URL=https://auth-stage.thebridge.dev

# Surfaced by the demo navbar's env pill, which global-setup asserts against the
# Playwright project — a demo left running in the wrong `--mode` fails loudly
# instead of quietly measuring another backend.
VITE_ENVIRONMENT=stage

# Empty = derived at runtime: callback from the page origin (so any HARNESS_PORT
# works), auth base URL from VITE_BRIDGE_API_BASE_URL, routes from SDK defaults.
VITE_BRIDGE_CALLBACK_URL=
VITE_BRIDGE_AUTH_BASE_URL=
VITE_BRIDGE_DEFAULT_REDIRECT_ROUTE=
VITE_BRIDGE_LOGIN_ROUTE=
VITE_BRIDGE_TEAM_MANAGEMENT_URL=
VITE_BRIDGE_DEBUG=true
