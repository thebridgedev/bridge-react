{
	"name": "@nebulr-group/bridge-react",
	"version": "1.0.0-alpha.1",
	"description": "The Bridge for React: sign-in in your own pages, workspaces, flag-based route guards, plans and checkout, the team panel and live updates, on one setting: the issuer.",
	"author": "Iman Pouya",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/thebridgedev/bridge-react.git"
	},
	"bugs": {
		"url": "https://github.com/thebridgedev/bridge-react/issues"
	},
	"homepage": "https://thebridge.dev/docs/quickstart/react/",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./styles": {
			"types": "./dist/styles.d.ts",
			"import": "./dist/styles.css",
			"default": "./dist/styles.css"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"README.md",
		"LICENSE"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/styles.css src/styles.d.ts dist/",
		"check": "tsc -p tsconfig.json --noEmit",
		"test:unit": "vitest run",
		"prepack": "bun run build && cp ../LICENSE ./LICENSE",
		"package": "bun run prepack && bun pm pack --destination ../"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0"
	},
	"dependencies": {
		"@nebulr-group/bridge-auth-core": "1.0.0-alpha.8"
	},
	"devDependencies": {
		"@testing-library/react": "^16.3.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"jose": "^6.2.3",
		"jsdom": "^26.1.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"typescript": "^5.9.0",
		"vitest": "^4.1.4"
	},
	"keywords": [
		"react",
		"the-bridge",
		"bridge",
		"authentication",
		"auth",
		"sign-in",
		"passkeys",
		"magic-link",
		"feature-flags",
		"stripe",
		"subscriptions",
		"billing",
		"multi-tenant",
		"workspaces",
		"saas"
	]
}
