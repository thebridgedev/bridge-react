{
	"name": "bridge-react-workspace",
	"private": true,
	"workspaces": [
		"bridge-react",
		"demo"
	],
	"scripts": {
		"check:docs-links": "node scripts/check-docs-links.mjs",
		"build": "bun run --filter demo build",
		"build:bridge": "bun run --filter @nebulr-group/bridge-react build",
		"dev": "bun run --filter demo dev",
		"package": "bun run --filter @nebulr-group/bridge-react package",
		"test:e2e": "bash scripts/check-no-networkidle.sh && bunx playwright test",
		"test:networkidle-guard": "bash scripts/check-no-networkidle.sh",
		"test:e2e:report": "bunx playwright show-report test-reports/playwright-report",
		"test:install": "bash scripts/test-install.sh",
		"test:unit": "bun run --filter @nebulr-group/bridge-react test:unit",
		"check": "bun run --filter @nebulr-group/bridge-react check && bun run --filter demo check"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@types/node": "^25.2.2"
	},
	"dependencies": {
		"@nebulr-group/bridge-auth-core": "1.0.0-alpha.8"
	}
}
